# Copy this file to ".env" and change the values.
# SA password must be strong: 8+ chars, upper + lower + digit + symbol
MSSQL_SA_PASSWORD=YourStrong@Passw0rd
DB_NAME=master

# Secret used to sign login tokens: at least 32 characters, keep it private.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-0000

# Host ports (change if already in use on your machine)
DB_PORT=1433
BACKEND_PORT=8080
FRONTEND_PORT=3000
